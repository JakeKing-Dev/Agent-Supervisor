{
  "uid": "agent-supervisor",
  "title": "Agent Supervisor",
  "tags": ["agents", "reliability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Runs halted",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "targets": [
        { "expr": "sum(agent_supervisor_freezes_total)", "legendFormat": "halted" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Spend prevented",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "targets": [
        { "expr": "sum(agent_supervisor_cost_saved_total)", "legendFormat": "saved" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Steps observed",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "targets": [
        { "expr": "sum(agent_supervisor_steps_total)", "legendFormat": "steps" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Currently frozen",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "targets": [
        { "expr": "sum(agent_supervisor_frozen)", "legendFormat": "frozen" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "timeseries",
      "title": "Drift score",
      "description": "0 to 1. The warn threshold sits at 0.5 and freeze at 0.7, subject to persistence.",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "targets": [
        { "expr": "agent_supervisor_drift_score", "legendFormat": "{{task}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.5, "color": "orange" },
              { "value": 0.7, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "showLegend": false } }
    },
    {
      "type": "piechart",
      "title": "Decisions",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "targets": [
        {
          "expr": "sum by (decision) (agent_supervisor_verdicts_total)",
          "legendFormat": "{{decision}}"
        }
      ],
      "options": { "legend": { "placement": "right" } }
    },
    {
      "type": "timeseries",
      "title": "Freeze rate",
      "description": "Freezes per minute, by reason.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "targets": [
        {
          "expr": "sum by (reason) (rate(agent_supervisor_freezes_total[1m])) * 60",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Run cost",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "targets": [
        { "expr": "agent_supervisor_run_cost", "legendFormat": "{{task}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "showLegend": false } }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      }
    ]
  }
}
